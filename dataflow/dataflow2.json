{
	"name": "dataflow2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_adls_input",
						"type": "DatasetReference"
					},
					"name": "employee"
				},
				{
					"dataset": {
						"referenceName": "Ds_adls_input",
						"type": "DatasetReference"
					},
					"name": "departments"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "Mainjoin"
				},
				{
					"name": "selectcolumn"
				}
			],
			"scriptLines": [
				"source(output(",
				"          employee_id as short,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          job_title as string,",
				"          department_id as short,",
				"          hire_date as date,",
				"          salary as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> employee",
				"source(output(",
				"          department_id as short,",
				"          department_name as string,",
				"          location_id as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> departments",
				"employee, departments join(employee@department_id == departments@department_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     partitionBy('hash', 1),",
				"     broadcast: 'auto')~> Mainjoin",
				"Mainjoin select(mapColumn(",
				"          first_name,",
				"          last_name,",
				"          email,",
				"          department_id = employee@department_id,",
				"          salary,",
				"          department_name,",
				"          location_id",
				"     ),",
				"     partitionBy('hash', 1),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectcolumn"
			]
		}
	}
}