{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "free-trial-adf-nd"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncprojadls.dfs.core.windows.net/"
		},
		"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1015-164448-ar7zrq8y"
		},
		"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-keyvaultkey.vault.azure.net/"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "free-server-nd.database.windows.net"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free_sql_db_nd"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "nd_user"
		},
		"LS_PostgreSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-red-tooth-b4owxxcx-pooler.c-6.us-east-2.aws.neon.tech"
		},
		"LS_PostgreSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"Trg_adls_to_sql_properties_PL_ADLS_TO_SQL_parameters_table_name": {
			"type": "string",
			"defaultValue": "orders"
		},
		"Trg_adls_to_sql_properties_PL_ADLS_TO_SQL_parameters_schema": {
			"type": "string",
			"defaultValue": "Dev_Schema"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "free-trial-adf-nd_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"LS_AzureSqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDatabase_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDatabase_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDatabase_properties_typeProperties_userName')]"
					},
					"LS_PostgreSql_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_server')]"
					},
					"LS_PostgreSql_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_database')]"
					},
					"LS_PostgreSql_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_username')]"
					},
					"Trg_adls_to_sql_properties_PL_ADLS_TO_SQL_parameters_table_name": {
						"value": "[parameters('Trg_adls_to_sql_properties_PL_ADLS_TO_SQL_parameters_table_name')]"
					},
					"Trg_adls_to_sql_properties_PL_ADLS_TO_SQL_parameters_schema": {
						"value": "[parameters('Trg_adls_to_sql_properties_PL_ADLS_TO_SQL_parameters_schema')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "free-trial-adf-nd_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'free-trial-adf-nd_ArmTemplate_0')]"
			]
		}
	]
}